# Optional: Connect Supabase for multi-instance Vercel serverless persistence & 200+ user Realtime WebSockets.
# Without these keys, Falcon Arena automatically runs in Built-in Hybrid Sync Mode (Server Memory + BroadcastChannel + Fast Polling).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Custom Host Passcode for launching/controlling official Falcon Town Hall sessions
NEXT_PUBLIC_FALCON_HOST_PIN=1994
